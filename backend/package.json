{
  "name": "takeone-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TakeOne managed video generation worker and dispatcher",
  "keywords": [
    "ffmpeg",
    "video",
    "shorts",
    "reels",
    "telegram",
    "ai",
    "captions",
    "yt-dlp"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "takeone": "node --import tsx src/cli.ts",
    "start": "node dist/managed/server.js",
    "worker": "node dist/managed/run.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "convex": "^1.42.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^11.0.2",
    "p-limit": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
