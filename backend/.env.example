# Shared Cloud Run Job configuration (use Secret Manager in production)
CONVEX_URL=https://your-deployment.convex.cloud
WORKER_SECRET=
GCS_BUCKET=takeone-videos
# Supplied per execution by the dispatcher, never a global queue poll.
TAKEONE_JOB_ID=

# Dispatcher service
DISPATCH_SECRET=
GCP_PROJECT=
GCP_REGION=us-central1
CLOUD_RUN_JOB=takeone-worker
PORT=8080

# Google Cloud. The worker calls every Google API with its attached service account
# through ADC, so there are no Google API keys here and never a Convex deploy key.
# A missing required value fails the job instead of falling back.

# Gemini on Vertex AI writes scripts and scene plans, picks moments and finds the
# subject for crops. gemini-3.8-flash is the current GA Flash model; use one your
# project can call.
GEMINI_PROJECT=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Speech-to-Text v2 Chirp 3 makes the captions. Audio goes through a short-lived
# speech/ object in GCS_BUCKET. SPEECH_PROJECT defaults to GEMINI_PROJECT.
SPEECH_LOCATION=us
SPEECH_MODEL=chirp_3
SPEECH_PROJECT=

# Text-to-Speech Chirp 3 HD reads the narration. The managed worker fails without
# both values; the offline CLI then uses macOS say or Linux espeak-ng.
TTS_VOICE=en-US-Chirp3-HD-Charon
TTS_LANGUAGE=en-US

# Best-effort copy of render progress in Firestore renders/{jobId}. Convex stays the
# source of truth. Leave empty to turn the copy off.
FIRESTORE_PROJECT=

# Backend modules that nothing in the app calls yet: Cloud Translation v3 for caption
# cues and Gemini 9:16 cover images. Both project values default to GEMINI_PROJECT.
TRANSLATE_PROJECT=
IMAGE_MODEL=
IMAGE_LOCATION=global
IMAGE_PROJECT=

# Prompt videos also need at least one stock footage provider. Keys alone do not
# prove quota. Edit-only operations may need fewer providers.
PEXELS_API_KEY=
PIXABAY_API_KEY=
GIPHY_API_KEY=
LINKUP_API_KEY=
TELEGRAM_BOT_TOKEN=
# Set to 0 to skip the Gemini subject crop. Wide sources then get a blur-pad fit
# unless the request asks for a crop.
SMART_CROP=1
YT_MAX_HEIGHT=1080

# Optional Veo 3 scene generation (ADC, no API key). Leave disabled in Convex
# until staging generation, permissions, quota and per-video cost are accepted.
VEO_PROJECT=
VEO_REGION=us-central1
VEO_MODEL=
