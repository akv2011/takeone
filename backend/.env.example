# Shared Cloud Run Job configuration (use Secret Manager in production)
CONVEX_URL=https://your-deployment.convex.cloud
WORKER_SECRET=
GCS_BUCKET=takeone-videos
# Supplied per execution by the dispatcher, never a global queue poll.
TAKEONE_JOB_ID=

# Dispatcher service
DISPATCH_SECRET=
GCP_PROJECT=
GCP_REGION=us-central1
CLOUD_RUN_JOB=takeone-worker
PORT=8080

# Stock generation requires LLM_API_KEY + an explicit LLM_MODEL, a working voice
# provider, WHISPER_API_KEY and at least one stock provider. Keys alone do not
# prove model access or quota. Edit-only operations may need fewer providers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
LINKUP_API_KEY=
GIPHY_API_KEY=
TELEGRAM_BOT_TOKEN=
# Runtime uses the attached service account via ADC; never a Convex deploy key.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
PIXABAY_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
SMART_CROP=1
VISION_MODEL=
YT_MAX_HEIGHT=1080

# Optional Veo 3 scene generation (ADC, no API key). Leave disabled in Convex
# until staging generation, permissions, quota and per-video cost are accepted.
VEO_PROJECT=
VEO_REGION=us-central1
VEO_MODEL=
