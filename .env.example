# Frontend (Vite). These are baked into the browser bundle, so they must be public values.
VITE_CONVEX_URL=            # Convex deployment URL, e.g. https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY= # Clerk publishable key (pk_test_... or pk_live_...)
VITE_POSTHOG_KEY=           # PostHog project key (phc_...), optional
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Convex CLI (local dev)
CONVEX_DEPLOYMENT=          # set by `npx convex dev`
VITE_CONVEX_SITE_URL=       # Convex HTTP actions URL (set by convex)

# Server-side secrets. Never expose these to the browser.
CLERK_SECRET_KEY=           # Clerk backend key (sk_...), server only

# Convex environment variables (set with `npx convex env set <NAME> <value>`):
#   CLERK_JWT_ISSUER_DOMAIN   https://<slug>.clerk.accounts.dev
#   RESEND_API_KEY            re_...              (waitlist welcome email)
#   WAITLIST_FROM             "TakeOne <hello@your-domain.example>"
#   DODO_API_KEY              live checkout (createCheckout)
