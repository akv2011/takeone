project_id = "your-gcp-project"
region     = "us-central1"
image      = "us-central1-docker.pkg.dev/your-gcp-project/takeone/backend:release"
# Hosted Convex (https://<name>.convex.cloud) or the HTTPS origin of a self-hosted backend.
convex_url = "https://your-deployment.convex.cloud"
dispatch_secret_id = "takeone-dispatch-secret"
worker_secrets = {
  WORKER_SECRET      = "takeone-worker-secret"
  TELEGRAM_BOT_TOKEN = "takeone-telegram-token"
  PEXELS_API_KEY     = "takeone-pexels-key"
}
worker_env = {}
# GA Gemini Flash ID since 2 Sep 2026 on the global endpoint, listed at https://docs.cloud.google.com/vertex-ai/generative-ai/docs/models/gemini/3-8-flash
gemini_model = "gemini-3.8-flash"
# Chirp 3 runs in the us and eu multi-regions, listed at https://docs.cloud.google.com/speech-to-text/docs/models/chirp-3
speech_location = "us"
speech_model    = "chirp_3"
# Chirp 3 HD voice names follow <locale>-Chirp3-HD-<voice>, listed at https://docs.cloud.google.com/text-to-speech/docs/chirp3-hd
tts_voice    = "en-US-Chirp3-HD-Charon"
tts_language = "en-US"
# Leave null to keep cover images disabled; they are not exposed in the app yet.
image_model = null
# Leave null until the product notice and retention policy match the chosen period.
video_retention_days = null
